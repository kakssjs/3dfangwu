{
  "name": "studio",
  "version": "0.1.0",
  "private": true,
  "description": "Our own code for I Renovation, the renovation design and contractor-matching platform: the NestJS API (N19), the home record (N9) and the Homebox connector (N11).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test --test-concurrency=3 \"test/*.test.ts\" \"dist/test/api/*.test.js\"",
    "test:postgres": "npm run build && node --disable-warning=ExperimentalWarning scripts/test-postgres.ts",
    "test:live": "node --disable-warning=ExperimentalWarning --test \"test/live/*.test.ts\"",
    "typecheck": "tsc -p .",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "api": "npm run build && node dist/src/api/main.js",
    "db:generate": "drizzle-kit generate",
    "sample": "node --disable-warning=ExperimentalWarning scripts/extract-floorplan-sample.ts",
    "home": "node --disable-warning=ExperimentalWarning scripts/home.ts",
    "homebox": "node --disable-warning=ExperimentalWarning scripts/homebox.ts",
    "email:authorize": "node --disable-warning=ExperimentalWarning scripts/outlook-authorize.ts",
    "email:test": "node --disable-warning=ExperimentalWarning scripts/email-test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.18",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@langchain/core": "1.3.5",
    "@langchain/langgraph": "1.7.1",
    "@langchain/openai": "1.8.0",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/throttler": "6.7.1",
    "china-area-data": "5.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "deepagents": "1.16.2",
    "drizzle-orm": "0.45.4",
    "langchain": "1.6.2",
    "langsmith": "0.9.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
}
