# Settings for the connectors and the API. `npm run homebox -- setup` and `npm run api -- setup` write the keys to .env.local for you.
# .env.local holds real keys: keep it on this PC and never share it.
HOMEBOX_URL=http://127.0.0.1:7745
HOMEBOX_API_KEY=
HOMEBOX_SERVICE_EMAIL=
HOMEBOX_SERVICE_PASSWORD=

# The API (`npm run api`). Changing STUDIO_JWT_SECRET signs everyone out.
STUDIO_JWT_SECRET=
STUDIO_ADMIN_KEY=
# Optional. The defaults are 127.0.0.1 and 3100.
# STUDIO_API_HOST=127.0.0.1
# STUDIO_API_PORT=3100
# The interface's address, used in the project and invitation links. Default: http://127.0.0.1:<STUDIO_API_PORT>
# STUDIO_SITE_URL=
# Where the database is kept. Default: ../runtime/studio-db
# Amap (高德) for the map and community search (D26). Real values go in .env.local, never here.
# AMAP_KEY=            Web (JS API) key from lbs.amap.com
# AMAP_SECURITY_CODE=  that key's security code (安全密钥); stays on the server
# A real PostgreSQL server (the cloud one, D8). Empty: PostgreSQL runs inside the app.
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/irenovation
# STUDIO_DB_DIR=
# Where uploads are kept. Default: ../runtime/studio-files
# STUDIO_FILES_DIR=

# MiMo API for the agents (N3). Real keys go in .env.local, never here.
MIMO_API_KEY=
# The MiMo endpoint, from the model access docs (模型接入文档).
MIMO_BASE_URL=
MIMO_MODEL=MiMo-V2.6-Pro

# Floor-plan reading backups (N4), tried when MiMo cannot answer. Real keys go in .env.local.
# Doubao (豆包, 火山方舟), OpenAI-style: a VLM from the Ark console (开通模型 first).
# DOUBAO_API_KEY=
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL=doubao-seed-2-1-lite-260915
# Agnes AI, OpenAI-style: works once its base URL and model are set from its console.
# AGNES_API_KEY=
# AGNES_BASE_URL=
# AGNES_MODEL=

# Email registration verification + code login. Off until a real SMTP sender is ready.
# Setup: docs/email-verification.md. Use an SMTP app password, never a key in browser code.
STUDIO_EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=sender@example.com
# SMTP_PASSWORD=
# SMTP_FROM=sender@example.com
